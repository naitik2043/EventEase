# Server
PORT=5000
NODE_ENV=development

# MongoDB (local MongoDB Community Server or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/eventease

# Use a long, random secret in real deployments.
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Optional: comma-separated frontend origins, e.g. http://localhost:5173,http://localhost:3000
# Leave empty to allow requests from any origin during local practical work.
CORS_ORIGIN=

# Used only by `npm run seed:admin`
ADMIN_NAME=EventEase Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
