# Application
PORT=5000
NODE_ENV=development

# Local replica-set MongoDB (transactions require a replica set)
MONGO_URI=mongodb://127.0.0.1:27017/eventease?replicaSet=rs0

# Set only when running integration tests; use an isolated DB name containing "test".
# Example: mongodb://127.0.0.1:27017/eventease_test?replicaSet=rs0
MONGO_TEST_URI=

# Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d

# Comma-separated trusted frontend/client origins. Required in production.
# Set this to the exact origin of the separate frontend application.
CORS_ORIGIN=http://localhost:3000

# Used only by npm run seed:admin
ADMIN_NAME=EventEase Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Optional transactional booking and waitlist emails (Resend)
# Configure a verified sender/domain in Resend before enabling.
RESEND_API_KEY=
MAIL_FROM=EventEase <notifications@example.com>
