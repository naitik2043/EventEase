{
  "name": "eventease-backend",
  "version": "1.2.0",
  "private": true,
  "description": "Full-stack React and Express event management platform with transactional bookings, FIFO waitlists, QR tickets and analytics",
  "type": "module",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "node --test",
    "test:unit": "node --test test/AppError.test.js test/asyncHandler.test.js",
    "test:integration": "node --test test/api.integration.test.js",
    "build": "node --check \"api/[...slug].js\" && npm run install:web && npm run build:web",
    "install:web": "npm install --prefix frontend --no-package-lock --no-audit --no-fund",
    "build:web": "npm run build --prefix frontend",
    "dev:web": "npm run dev --prefix frontend",
    "preview:web": "npm run preview --prefix frontend"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "author": "Naitik Gupta",
  "keywords": [
    "event-management",
    "event-registration",
    "full-stack",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "jwt",
    "transactions",
    "qr-tickets",
    "waitlist",
    "backend",
    "react",
    "vite",
    "frontend",
    "dashboard"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/naitik2043/EventEase.git"
  },
  "bugs": {
    "url": "https://github.com/naitik2043/EventEase/issues"
  },
  "homepage": "https://github.com/naitik2043/EventEase#readme"
}
